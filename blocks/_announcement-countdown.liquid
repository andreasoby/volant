{% render 'text-block-styles' %}

{%- liquid
  assign block_settings = block.settings
  assign block_index = section.blocks | find_index: 'id', block.id
  assign ends_at = block_settings.ends_at | strip | replace: 'T', ' '
  assign valid_date = false

  if ends_at != blank and ends_at.size >= 16
    assign year_separator = ends_at | slice: 4, 1
    assign month_separator = ends_at | slice: 7, 1
    assign day_separator = ends_at | slice: 10, 1
    assign time_separator = ends_at | slice: 13, 1
    if year_separator == '-' and month_separator == '-' and day_separator == ' ' and time_separator == ':'
      assign valid_date = true
    endif
  endif
-%}

{%- if valid_date or request.design_mode -%}
  {%- liquid
    assign days_label = 'content.countdown_days' | t
    assign hours_label = 'content.countdown_hours' | t
    assign minutes_label = 'content.countdown_minutes' | t

    if valid_date
      assign now_timestamp = 'now' | date: '%s' | plus: 0
      assign end_timestamp = ends_at | date: '%s' | plus: 0
      assign remaining_seconds = end_timestamp | minus: now_timestamp
      if remaining_seconds < 0
        assign remaining_seconds = 0
      endif
      assign total_minutes = remaining_seconds | divided_by: 60
      assign days = total_minutes | divided_by: 1440
      assign minutes_after_days = total_minutes | modulo: 1440
      assign hours = minutes_after_days | divided_by: 60
      assign minutes = minutes_after_days | modulo: 60
      assign hours_text = hours
      assign minutes_text = minutes
      if hours < 10
        assign hours_text = hours | prepend: '0'
      endif
      if minutes < 10
        assign minutes_text = minutes | prepend: '0'
      endif
      assign countdown_text = days | append: ' ' | append: days_label | append: '  ' | append: hours_text | append: ' ' | append: hours_label | append: '  ' | append: minutes_text | append: ' ' | append: minutes_label
      assign end_iso = ends_at | date: '%Y-%m-%dT%H:%M:%S%z'
    else
      assign countdown_text = 'content.countdown_placeholder' | t
    endif
  -%}

  {%- if valid_date -%}
    <script
      src="{{ 'announcement-countdown.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
  {%- endif -%}

  {%- capture announcement_content -%}
    {%- if valid_date -%}
      <announcement-countdown
        class="announcement-countdown"
        data-end="{{ end_timestamp }}"
        data-label-days="{{ days_label | escape }}"
        data-label-hours="{{ hours_label | escape }}"
        data-label-minutes="{{ minutes_label | escape }}"
      >
        <p class="announcement-bar__text">
          <time
            class="announcement-countdown__time"
            datetime="{{ end_iso }}"
            data-countdown-value
          >{{ countdown_text }}</time>
        </p>
      </announcement-countdown>
    {%- else -%}
      <p class="announcement-bar__text">{{ countdown_text }}</p>
    {%- endif -%}

    {% if block_settings.link != blank %}
      <a
        class="announcement-bar__link"
        href="{{ block_settings.link }}"
      >
        <span class="visually-hidden">
          {{ countdown_text }}
        </span>
      </a>
    {% endif %}
  {%- endcapture -%}

  {%- capture announcement_style -%}
    {% render 'typography-style', settings: block_settings, preset: 'custom' %}
    {% if block_settings.text_color != blank %}--color: {{ block_settings.text_color }}; --color-rgb: {{ block_settings.text_color.rgb }};{% endif %}
    --line-height: 1;
  {%- endcapture -%}

  {%- if section.settings.display == 'marquee' -%}
    <div
      class="
        announcement-bar__marquee-item
        text-block
        text-block--{{ block.id }}
        custom-typography
        {% if block_settings.font_size != "" %}custom-font-size{% endif %}
        {% if block_settings.weight != "" %}custom-font-weight{% endif %}
      "
      style="
        {{ announcement_style }}
        --width: fit-content;
        --text-align: center;
        --text-wrap: nowrap;
      "
      {{ block.shopify_attributes }}
    >
      {{ announcement_content }}
    </div>
  {%- else -%}
    <slideshow-slide
      ref="slides[]"
      class="
        announcement-bar__slide
        text-block
        text-block--{{ block.id }}
        text-block--align-center
        text-block--full-width
        custom-typography
        {% if block_settings.font_size != "" %}custom-font-size{% endif %}
        {% if block_settings.weight != "" %}custom-font-weight{% endif %}
      "
      style="
        {{ announcement_style }}
        --width: 100%;
        --text-align: center;
      "
      {{ block.shopify_attributes }}
      aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
    >
      {{ announcement_content }}
    </slideshow-slide>
  {%- endif -%}
{%- endif -%}

