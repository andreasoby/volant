{%- liquid
  assign bundle_field = product.metafields.custom.bundle_products
  assign bundle_count = 0

  if bundle_field.type == 'list.product_reference'
    assign bundle_count = bundle_field.value.size
  elsif bundle_field.type == 'product_reference' and bundle_field.value != blank
    assign bundle_count = 1
  endif

  assign use_samples = false
  if bundle_count == 0 and request.design_mode
    assign use_samples = true
  endif

  assign heading = section.settings.heading | strip
  if heading == blank
    assign heading_field = product.metafields.custom.bundle_heading
    if heading_field.type == 'rich_text_field'
      assign heading = heading_field | metafield_text | strip
    else
      assign heading = heading_field.value | strip
    endif
  endif

  if use_samples and heading == blank
    assign heading = 'bundle_products.samples.heading' | t
  endif

  assign bundle_visibility = ''
  if section.settings.show_on_mobile == false
    assign bundle_visibility = bundle_visibility | append: ' bundle-products--hide-mobile'
  endif
  if section.settings.show_on_desktop == false
    assign bundle_visibility = bundle_visibility | append: ' bundle-products--hide-desktop'
  endif

  assign show_bundle = false
  if bundle_count > 0 or use_samples
    assign show_bundle = true
  endif
-%}

{%- if show_bundle -%}
  <style>
    @font-face {
      font-family: 'IBM Plex Sans';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('{{ 'ibm-plex-sans-ext-400.woff2' | asset_url }}') format('woff2');
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }

    @font-face {
      font-family: 'IBM Plex Sans';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('{{ 'ibm-plex-sans-400.woff2' | asset_url }}') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    @font-face {
      font-family: 'IBM Plex Serif';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('{{ 'ibm-plex-serif-ext-400.woff2' | asset_url }}') format('woff2');
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }

    @font-face {
      font-family: 'IBM Plex Serif';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('{{ 'ibm-plex-serif-400.woff2' | asset_url }}') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    @font-face {
      font-family: 'IBM Plex Serif';
      font-style: italic;
      font-weight: 400;
      font-display: swap;
      src: url('{{ 'ibm-plex-serif-italic-400.woff2' | asset_url }}') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
  </style>

  <div class="bundle-products-root{{ bundle_visibility }}">
    <div class="section-background bundle-products__backdrop"></div>
    <div
      class="section section--{{ section.settings.section_width }} bundle-products"
      {% if heading != blank %}
        aria-labelledby="BundleProducts-{{ section.id }}"
      {% else %}
        aria-label="{{ 'bundle_products.label' | t }}"
      {% endif %}
    >
      <div class="bundle-products__layout">
        {%- if use_samples -%}
          <p class="bundle-products__note">{{ 'bundle_products.empty' | t }}</p>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 id="BundleProducts-{{ section.id }}" class="bundle-products__heading">
            {{ heading }}
          </h2>
        {%- endif -%}

        <div class="bundle-products__scroller">
          <ul class="bundle-products__list">
            {%- if use_samples -%}
              {%- for sample_index in (1..3) -%}
                <li class="bundle-products__item">
                  {% render 'bundle-product-card', sample_index: sample_index %}
                </li>
              {%- endfor -%}
            {%- elsif bundle_field.type == 'product_reference' -%}
              <li class="bundle-products__item">
                {% render 'bundle-product-card', card_product: bundle_field.value %}
              </li>
            {%- else -%}
              {%- for bundle_product in bundle_field.value -%}
                {%- if bundle_product != blank and bundle_product.title != blank -%}
                  <li class="bundle-products__item">
                    {% render 'bundle-product-card', card_product: bundle_product %}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .bundle-products-section.shopify-section .section-background,
  .bundle-products__backdrop {
    background-color: #eadec6;
  }

  .bundle-products.section {
    padding-top: 72px;
    padding-bottom: 80px;
    color: #111;
  }

  .bundle-products__layout {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
    container-type: inline-size;
  }

  .bundle-products__note {
    margin: 0;
    color: #6b6357;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 13px;
    line-height: 1.4;
  }

  .bundle-products__heading {
    margin: 0;
    color: #111;
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: normal;
  }

  .bundle-products__scroller {
    min-width: 0;
  }

  .bundle-products__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bundle-products__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .bundle-products__card:focus-visible {
    outline: 1px solid #111;
    outline-offset: 4px;
  }

  .bundle-products__media {
    aspect-ratio: 1;
    overflow: hidden;
    background: #3a3a3c;
  }

  .bundle-products__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bundle-products__producer,
  .bundle-products__title,
  .bundle-products__meta,
  .bundle-products__text,
  .bundle-products__cta {
    margin: 0;
  }

  .bundle-products__producer {
    margin-top: 12px;
    color: #6b6357;
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 15px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.3;
  }

  .bundle-products__title {
    margin-top: 2px;
    color: #111;
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.25;
  }

  .bundle-products__meta {
    margin-top: 2px;
    color: #6b6357;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
  }

  .bundle-products__text {
    margin-top: 8px;
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.4;
  }

  .bundle-products__cta {
    margin-top: 10px;
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  a.bundle-products__card:hover .bundle-products__cta {
    color: #6b6357;
  }

  @media screen and (max-width: 989px) and (min-width: 750px) {
    .bundle-products__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .bundle-products-section:has(.bundle-products--hide-mobile) {
      display: none !important;
    }

    .bundle-products.section {
      padding-top: 48px;
      padding-bottom: 48px;
    }

    .bundle-products__layout {
      gap: 20px;
    }

    .bundle-products__heading {
      font-size: 26px;
    }

    .bundle-products__scroller {
      margin-inline-end: calc(var(--util-page-margin-offset) * -1);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .bundle-products__scroller::-webkit-scrollbar {
      display: none;
    }

    .bundle-products__list {
      display: flex;
      gap: 12px;
      width: max-content;
      padding-inline-end: var(--util-page-margin-offset);
    }

    .bundle-products__item {
      flex: 0 0 calc(100cqw - 72px);
      scroll-snap-align: start;
    }

    .bundle-products__item:only-child {
      flex-basis: 100cqw;
    }

    .bundle-products__title {
      font-size: 20px;
    }
  }

  @media screen and (min-width: 750px) {
    .bundle-products-section:has(.bundle-products--hide-desktop) {
      display: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.bundle_products",
  "tag": "section",
  "class": "bundle-products-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.bundle_products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "t:settings.show_on_mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "t:settings.show_on_desktop",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:names.bundle_products",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
