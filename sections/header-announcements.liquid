{% liquid
  assign announcement_display = section.settings.display | default: 'rotate'
  assign is_marquee = false
  if announcement_display == 'marquee'
    assign is_marquee = true
  endif

  assign marquee_speed = section.settings.marquee_speed | default: 5
  assign marquee_speed_factor = 11 | minus: marquee_speed | times: 5
%}

{% if is_marquee %}
  <script
    src="{{ 'marquee.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% elsif section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% if is_marquee %}
    <marquee-component
      class="announcement-bar__marquee force-full-width"
      style="--marquee-direction: normal; --marquee-gap: 1.5rem;"
      data-speed-factor="{{ marquee_speed_factor }}"
    >
      <div
        class="marquee__wrapper"
        ref="wrapper"
      >
        <div
          class="marquee__content"
          ref="content"
        >
          <div
            class="marquee__repeated-items"
            ref="marqueeItems[]"
          >
  {% else %}
    {% liquid
      assign autoplay = false
      assign show_arrows = false
      if section.blocks.size > 1
        assign autoplay = true
        assign show_arrows = true
      endif
    %}

    <announcement-bar-component
      class="announcement-bar__slider"
      {% if autoplay == true %}
        autoplay="{{ section.settings.speed }}" aria-live="polite"
      {% endif %}
    >
      {% if show_arrows %}
        {% render 'slideshow-arrows', icon_style: 'chevron' %}
      {% endif %}

      <div class="announcement-bar__slides">
  {% endif %}
    {% content_for 'blocks' %}
  {% if is_marquee %}
          </div>
        </div>
      </div>
    </marquee-component>
  {% else %}
      </div>
    </announcement-bar-component>
  {% endif %}
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slider .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  announcement-countdown {
    display: block;
    white-space: nowrap;
  }

  .announcement-countdown__time {
    font-variant-numeric: tabular-nums;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  .announcement-bar__marquee {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .announcement-bar__marquee .marquee__wrapper {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    width: fit-content;
    white-space: nowrap;
  }

  .announcement-bar__marquee .marquee__content,
  .announcement-bar__marquee .marquee__repeated-items {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    min-width: max-content;
  }

  .announcement-bar__marquee-item.text-block {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--marquee-gap);
    flex-shrink: 0;
    max-width: none;
    position: relative;
    white-space: nowrap;
  }

  .announcement-bar__marquee-item::after {
    content: '';
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  .announcement-bar__marquee-item .announcement-bar__link:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 0.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .announcement-bar__marquee:not([data-disabled]) .marquee__wrapper {
      animation: announcement-marquee-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  @keyframes announcement-marquee-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    },
    {
      "type": "_announcement-countdown"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "display",
      "label": "t:settings.animation",
      "options": [
        {
          "value": "rotate",
          "label": "t:options.one_by_one"
        },
        {
          "value": "marquee",
          "label": "t:names.marquee"
        }
      ],
      "default": "rotate"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.display == 'rotate' }}"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:settings.speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.display == 'marquee' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
