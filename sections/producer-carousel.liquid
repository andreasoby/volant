{%- liquid
  assign position_template = 'producer_carousel.position' | t: current: '__CURRENT__', total: '__TOTAL__'
  assign use_gallery = false
  assign gallery_cards = blank
  assign card_count = section.blocks.size
  assign producer_entry = product.metafields.custom.producer_object.value
  if request.page_type == 'collection'
    assign producer_entry = collection.metafields.custom.producer_object.value
  endif
  assign header_link = section.settings.link

  if header_link == blank and request.page_type == 'product'
    assign producer_collection = producer_entry.collection_page.value
    if producer_collection.url != blank
      assign header_link = producer_collection.url
    elsif producer_collection.first.url != blank
      assign header_link = producer_collection.first.url
    endif
  endif

  if section.settings.cards_source == 'producer_gallery'
    assign use_gallery = true
    assign gallery_cards = producer_entry.gallery.value
    assign card_count = 0

    for gallery_card in gallery_cards
      assign gallery_image = gallery_card.image.value
      assign gallery_kicker = gallery_card.kicker | metafield_text | strip
      if gallery_kicker == blank
        assign gallery_kicker = gallery_card.kicker.value | strip
      endif
      assign gallery_title = gallery_card.title | metafield_text | strip
      if gallery_title == blank
        assign gallery_title = gallery_card.title.value | strip
      endif
      assign gallery_text = gallery_card.text | metafield_text | strip
      if gallery_text == blank
        assign gallery_text = gallery_card.text.value | strip
      endif

      if gallery_image != blank or gallery_kicker != blank or gallery_title != blank or gallery_text != blank
        assign card_count = card_count | plus: 1
      endif
    endfor
  endif
-%}

<div class="section-background producer-carousel__backdrop"></div>

<div
  class="section section--{{ section.settings.section_width }} producer-carousel"
  {% if section.settings.heading != blank %}
    aria-labelledby="ProducerCarousel-{{ section.id }}"
  {% else %}
    aria-label="{{ 'producer_carousel.label' | t }}"
  {% endif %}
>
  {% if section.settings.heading != blank or section.settings.link_label != blank %}
    <div class="producer-carousel__header">
      {% if section.settings.heading != blank %}
        <h2 id="ProducerCarousel-{{ section.id }}" class="producer-carousel__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.link_label != blank %}
        {% if header_link != blank %}
          <a class="producer-carousel__header-link" href="{{ header_link }}">
            {{ section.settings.link_label }}
          </a>
        {% else %}
          <span class="producer-carousel__header-link">{{ section.settings.link_label }}</span>
        {% endif %}
      {% endif %}
    </div>
  {% endif %}

  {% if card_count > 0 %}
    <producer-carousel
      class="producer-carousel__viewport"
      data-position="{{ position_template | escape }}"
    >
      <ul class="producer-carousel__track is-instant" data-track>
        {% if use_gallery %}
          {%- assign shown_index = 0 -%}
          {%- for gallery_card in gallery_cards -%}
            {%- liquid
              assign card_image = gallery_card.image.value
              if card_image.preview_image != blank
                assign card_image = card_image.preview_image
              endif
              assign card_eyebrow = gallery_card.kicker | metafield_text | strip
              if card_eyebrow == blank
                assign card_eyebrow = gallery_card.kicker.value | strip
              endif
              assign card_title = gallery_card.title | metafield_text | strip
              if card_title == blank
                assign card_title = gallery_card.title.value | strip
              endif
              assign card_text = gallery_card.text | metafield_text | strip
              if card_text == blank
                assign card_text = gallery_card.text.value | strip
              endif
              assign card_label = card_title | default: card_eyebrow
              assign show_title = card_title | default: card_label
              assign card_is_first = false
              if shown_index == 0
                assign card_is_first = true
              endif
            -%}
            {%- if card_image != blank or card_eyebrow != blank or card_title != blank or card_text != blank -%}
              <li
                class="producer-carousel__card{% if card_is_first %} is-active{% endif %}"
                data-card
                data-logical="{{ shown_index }}"
                data-title="{{ show_title | escape }}"
              >
                {% render 'producer-carousel-card',
                  index: shown_index,
                  total: card_count,
                  is_first: card_is_first,
                  image: card_image,
                  eyebrow: card_eyebrow,
                  title: card_title,
                  text: card_text,
                  label: card_label
                %}
              </li>
              {%- assign shown_index = shown_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {% else %}
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_label = block.settings.label | default: block.settings.title
              assign show_title = block.settings.title | default: card_label
              assign card_link = block.settings.link

              if block.settings.link_source == 'producentlink'
                assign producer_field = product.metafields.custom.producentlink
                assign card_link = ''

                if producer_field != blank
                  if producer_field.type == 'collection_reference' or producer_field.type == 'page_reference' or producer_field.type == 'product_reference' or producer_field.type == 'link'
                    assign card_link = producer_field.value.url
                  elsif producer_field.type == 'url'
                    assign card_link = producer_field.value
                  elsif producer_field.type == 'list.collection_reference'
                    assign card_link = producer_field.value.first.url
                  elsif producer_field.value.url != blank
                    assign card_link = producer_field.value.url
                  endif
                endif
              endif
            -%}
            <li
              class="producer-carousel__card{% if forloop.first %} is-active{% endif %}"
              data-card
              data-logical="{{ forloop.index0 }}"
              data-title="{{ show_title | escape }}"
              {{ block.shopify_attributes }}
            >
              {% render 'producer-carousel-card',
                index: forloop.index0,
                total: card_count,
                is_first: forloop.first,
                image: block.settings.image,
                eyebrow: block.settings.eyebrow,
                title: block.settings.title,
                text: block.settings.text,
                label: card_label,
                link: card_link,
                link_label: block.settings.link_label
              %}
            </li>
          {%- endfor -%}
        {% endif %}
      </ul>
      <p class="visually-hidden" data-status aria-live="polite"></p>
    </producer-carousel>
  {% endif %}
</div>

{% stylesheet %}
  .producer-carousel-section.shopify-section .section-background,
  .producer-carousel__backdrop {
    background-color: #eadec6;
  }

  .producer-carousel.section {
    row-gap: 32px;
    padding-top: 96px;
    padding-bottom: 96px;
    color: #111;
  }

  .producer-carousel__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .producer-carousel__heading {
    margin: 0;
    color: #111;
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 36px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
  }

  .producer-carousel__header-link,
  .producer-carousel__link {
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-weight: 400;
    line-height: normal;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .producer-carousel__header-link {
    flex: none;
    font-size: 15px;
  }

  a.producer-carousel__header-link:hover,
  a.producer-carousel__link:hover {
    color: #6b6357;
  }

  producer-carousel {
    display: block;
    min-width: 0;
    overflow: hidden;
    container-type: inline-size;
  }

  .producer-carousel__track {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .producer-carousel__track.is-instant {
    transition: none;
  }

  .producer-carousel__card {
    position: relative;
    flex: 0 0 auto;
    width: min(528px, calc(100cqw - 40px));
    aspect-ratio: 528 / 660;
    overflow: hidden;
    background: #d7cbb4;
  }

  .producer-carousel__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .producer-carousel__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  .producer-carousel__image--limar {
    inset: auto;
    top: -3.83%;
    left: -36.69%;
    width: 460.49%;
    height: 204.92%;
    max-width: none;
    object-fit: fill;
  }

  .producer-carousel__select {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 1;
    transition: opacity 0.45s ease;
  }

  .producer-carousel__card.is-active .producer-carousel__select {
    opacity: 0;
    pointer-events: none;
  }

  .producer-carousel__label {
    position: absolute;
    left: 24px;
    bottom: 24px;
    max-width: calc(100% - 48px);
    margin: 0;
    padding: 12px 18px;
    background: #eadec6;
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: 0.72px;
    text-align: left;
  }

  .producer-carousel__panel {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: min(440px, calc(100% - 48px));
    max-height: calc(100% - 48px);
    margin: 0;
    padding: 24px 28px;
    overflow: auto;
    background: #eadec6;
    color: #111;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.45s ease, visibility 0.45s ease;
  }

  .producer-carousel__card.is-active .producer-carousel__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  producer-carousel.is-settling .producer-carousel__panel,
  producer-carousel.is-settling .producer-carousel__select {
    transition: none;
  }

  .producer-carousel__eyebrow,
  .producer-carousel__title,
  .producer-carousel__text,
  .producer-carousel__count {
    margin: 0;
  }

  .producer-carousel__eyebrow,
  .producer-carousel__count {
    color: #6b6357;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: 0.72px;
    text-transform: uppercase;
  }

  .producer-carousel__count {
    color: #111;
    white-space: nowrap;
  }

  .producer-carousel__title {
    color: #111;
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 30px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
  }

  .producer-carousel__text {
    color: #111;
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.4;
  }

  .producer-carousel__controls {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding-top: 6px;
  }

  .producer-carousel__nav {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border: 1px solid #111;
    border-radius: 100px;
    background: transparent;
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    cursor: pointer;
  }

  .producer-carousel__nav:hover {
    background: #111;
    color: #eadec6;
  }

  .producer-carousel__link {
    margin-inline-start: auto;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .producer-carousel.section {
      row-gap: 24px;
      padding-top: 48px;
      padding-bottom: 48px;
    }

    .producer-carousel__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .producer-carousel__heading {
      font-size: 28px;
    }

    .producer-carousel__panel {
      padding: 18px 20px;
    }

    .producer-carousel__title {
      font-size: 26px;
    }

    .producer-carousel__text {
      font-size: 15px;
    }

    .producer-carousel__controls {
      flex-wrap: wrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .producer-carousel__track,
    .producer-carousel__panel,
    .producer-carousel__select {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
class ProducerCarousel extends HTMLElement {
  connectedCallback() {
    this.track = this.querySelector('[data-track]');
    this.count = this.cards().length;
    this.cloneLoop();
    this.index = this.count > 1 ? this.count : 0;
    this.drag = null;
    this.suppressClick = false;
    this.pendingFocus = null;

    this.onClick = (event) => {
      if (this.suppressClick) {
        this.suppressClick = false;
        event.preventDefault();
        event.stopPropagation();
        return;
      }

      if (event.target.closest('[data-next]')) {
        event.preventDefault();
        this.move(1);
        return;
      }

      if (event.target.closest('[data-prev]')) {
        event.preventDefault();
        this.move(-1);
        return;
      }

      const select = event.target.closest('[data-select]');
      if (!select) return;
      const card = select.closest('[data-card]');
      const index = this.cards().indexOf(card);
      if (index < 0 || index === this.index) return;
      this.index = index;
      this.render(true);
      this.restoreFocus();
    };

    this.onKeydown = (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        this.move(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        this.move(-1);
      }
    };

    this.onPointerDown = (event) => {
      if (event.button !== 0) return;
      if (event.target.closest('[data-next], [data-prev], a')) return;
      this.drag = {
        x: event.clientX,
        pointerId: event.pointerId,
        dragged: false,
      };
    };

    this.onPointerMove = (event) => {
      if (!this.drag || event.pointerId !== this.drag.pointerId) return;
      if (Math.abs(event.clientX - this.drag.x) > 8) this.drag.dragged = true;
    };

    this.onPointerUp = (event) => {
      if (!this.drag || event.pointerId !== this.drag.pointerId) return;
      const distance = event.clientX - this.drag.x;
      const dragged = this.drag.dragged && Math.abs(distance) > 48;
      this.drag = null;
      if (!dragged) return;
      this.suppressClick = true;
      this.move(distance < 0 ? 1 : -1);
    };

    this.onBlockSelect = (event) => {
      const card = event.target?.closest?.('[data-card]');
      if (!card || card.hasAttribute('data-clone') || !this.contains(card)) return;
      const logical = Number(card.dataset.logical);
      if (Number.isNaN(logical)) return;
      this.index = this.count > 1 ? this.count + logical : logical;
      this.render(false);
    };

    this.onTransitionEnd = (event) => {
      if (event.target !== this.track || event.propertyName !== 'transform') return;
      this.animating = false;
      this.settle();
    };

    this.addEventListener('click', this.onClick);
    this.addEventListener('keydown', this.onKeydown);
    this.addEventListener('pointerdown', this.onPointerDown);
    this.addEventListener('pointermove', this.onPointerMove);
    this.addEventListener('pointerup', this.onPointerUp);
    this.addEventListener('pointercancel', this.onPointerUp);
    this.track?.addEventListener('transitionend', this.onTransitionEnd);
    document.addEventListener('shopify:block:select', this.onBlockSelect);

    this.animating = false;
    this.observer = new ResizeObserver(() => {
      if (this.animating) return;
      this.render(false);
    });
    this.observer.observe(this);
    this.render(false);
  }

  disconnectedCallback() {
    this.removeEventListener('click', this.onClick);
    this.removeEventListener('keydown', this.onKeydown);
    this.removeEventListener('pointerdown', this.onPointerDown);
    this.removeEventListener('pointermove', this.onPointerMove);
    this.removeEventListener('pointerup', this.onPointerUp);
    this.removeEventListener('pointercancel', this.onPointerUp);
    this.track?.removeEventListener('transitionend', this.onTransitionEnd);
    document.removeEventListener('shopify:block:select', this.onBlockSelect);
    this.observer?.disconnect();
  }

  cards() {
    return [...this.querySelectorAll('[data-card]')];
  }

  cloneLoop() {
    if (!this.track || this.count < 2) return;
    const originals = [...this.track.children];
    const copy = (source) => {
      const clone = source.cloneNode(true);
      clone.setAttribute('data-clone', '');
      clone.setAttribute('aria-hidden', 'true');
      [...clone.attributes].forEach((attr) => {
        if (attr.name.includes('shopify')) clone.removeAttribute(attr.name);
      });
      clone.querySelectorAll('button, a').forEach((element) => {
        element.tabIndex = -1;
      });
      return clone;
    };
    this.track.prepend(...originals.map(copy));
    this.track.append(...originals.map(copy));
  }

  logical() {
    if (this.count < 1) return 0;
    return ((this.index % this.count) + this.count) % this.count;
  }

  step() {
    const card = this.cards()[0];
    if (!card || !this.track) return 0;
    const gap = Number.parseFloat(getComputedStyle(this.track).columnGap) || 0;
    return card.offsetWidth + gap;
  }

  prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  move(delta) {
    if (this.count < 2) return;
    this.pendingFocus = document.activeElement?.matches?.('[data-next]')
      ? 'next'
      : document.activeElement?.matches?.('[data-prev]')
        ? 'prev'
        : null;
    this.settle();
    this.index += delta;
    this.render(true);
    this.restoreFocus();
  }

  settle() {
    if (this.count < 2) return;
    const normalized = this.count + this.logical();
    if (this.index === normalized) return;
    const focused = document.activeElement;
    const focusSelector = focused?.matches?.('[data-prev]')
      ? '[data-prev]'
      : focused?.matches?.('[data-next]')
        ? '[data-next]'
        : null;
    this.index = normalized;
    this.classList.add('is-settling');
    this.track.classList.add('is-instant');
    this.track.style.transform = `translate3d(${-this.index * this.step()}px, 0, 0)`;
    this.syncState(false);
    this.offsetWidth;
    this.classList.remove('is-settling');
    if (focusSelector && focused && this.contains(focused)) {
      this.cards()[this.index]?.querySelector(focusSelector)?.focus();
    }
  }

  restoreFocus() {
    if (!this.pendingFocus) return;
    const selector = this.pendingFocus === 'prev' ? '[data-prev]' : '[data-next]';
    this.pendingFocus = null;
    this.cards()[this.index]?.querySelector(selector)?.focus();
  }

  render(animate) {
    const cards = this.cards();
    if (!this.track || this.count === 0) return;

    const motion = animate && !this.prefersReducedMotion();
    this.animating = motion;
    if (motion) {
      this.track.classList.remove('is-instant');
      this.offsetWidth;
    } else {
      this.classList.add('is-settling');
      this.track.classList.add('is-instant');
    }

    this.track.style.transform = `translate3d(${-this.index * this.step()}px, 0, 0)`;
    this.syncState(motion);

    if (!motion) {
      this.offsetWidth;
      this.classList.remove('is-settling');
      this.settle();
    }
  }

  syncState(announce) {
    const cards = this.cards();
    const logical = this.logical();
    const template = this.dataset.position || '';
    const label = template
      .replace('__CURRENT__', String(logical + 1))
      .replace('__TOTAL__', String(this.count));

    cards.forEach((card, index) => {
      const active = index === this.index;
      card.classList.toggle('is-active', active);
      const select = card.querySelector('[data-select]');
      if (!select || card.hasAttribute('data-clone')) return;
      select.tabIndex = active ? -1 : 0;
      select.setAttribute('aria-hidden', active ? 'true' : 'false');
    });

    this.querySelectorAll('[data-count]').forEach((node) => {
      node.textContent = label;
    });

    if (!announce) return;
    const status = this.querySelector('[data-status]');
    const title = cards[this.index]?.dataset.title || '';
    if (status) status.textContent = title ? `${label}. ${title}` : label;
  }
}

if (!customElements.get('producer-carousel')) {
  customElements.define('producer-carousel', ProducerCarousel);
}
{% endjavascript %}

