<style>
  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('{{ 'ibm-plex-sans-ext-500.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('{{ 'ibm-plex-sans-500.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'IBM Plex Serif';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-serif-ext-400.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'IBM Plex Serif';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-serif-400.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'IBM Plex Serif';
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-serif-italic-400.woff2' | asset_url }}') format('woff2');
  }
</style>

{%- liquid
  assign metaobject_type = section.settings.metaobject_type | default: 'producer'
  assign other_label = 'producer_index.other' | t
  assign catalog = ''
  assign offsets = '0,50,100,150,200' | split: ','
-%}

{%- paginate shop.metaobjects[metaobject_type].values by 250 -%}
  {%- for offset in offsets -%}
    {%- assign page_offset = offset | plus: 0 -%}
    {%- for producer in shop.metaobjects[metaobject_type].values limit: 50 offset: page_offset -%}
      {%- capture row -%}
        {%- render 'producer-index-row', producer: producer, other_label: other_label -%}
      {%- endcapture -%}
      {%- assign row = row | strip -%}
      {%- if row != blank -%}
        {%- if catalog != blank -%}
          {%- assign catalog = catalog | append: '~|~' -%}
        {%- endif -%}
        {%- assign catalog = catalog | append: row -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endpaginate -%}

{%- if catalog != blank -%}
  {%- assign rows = catalog | split: '~|~' | sort -%}
{%- endif -%}

<div class="section-background producer-index__backdrop"></div>

<div
  class="section section--{{ section.settings.section_width }} producer-index"
  {% if section.settings.heading != blank %}
    aria-labelledby="ProducerIndex-{{ section.id }}"
  {% else %}
    aria-label="{{ 'producer_index.label' | t }}"
  {% endif %}
>
  {%- if section.settings.heading != blank -%}
    <h2 id="ProducerIndex-{{ section.id }}" class="producer-index__heading">
      {{ section.settings.heading | escape }}
    </h2>
  {%- endif -%}

  {%- if catalog != blank -%}
    {%- assign previous_country = '' -%}
    <div class="producer-index__groups">
      {%- for row in rows -%}
        {%- liquid
          assign parts = row | split: '~^~'
          assign country_key = parts[0]
          assign country_label = parts[1]
        -%}
        {%- if country_key == blank or country_key == previous_country -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign previous_country = country_key -%}
        {%- assign country_count = 0 -%}
        {%- for candidate in rows -%}
          {%- assign candidate_key = candidate | split: '~^~' | first -%}
          {%- if candidate_key == country_key -%}
            {%- assign country_count = country_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="producer-index__group">
          <h3 id="ProducerIndex-{{ section.id }}-{{ forloop.index }}" class="producer-index__country">
            <span class="producer-index__country-name">{{ country_label | escape }}</span>
            <span class="producer-index__count">{{ country_count }}</span>
          </h3>
          <ul
            class="producer-index__list list-unstyled"
            aria-labelledby="ProducerIndex-{{ section.id }}-{{ forloop.index }}"
          >
            {%- for candidate in rows -%}
              {%- liquid
                assign item_parts = candidate | split: '~^~'
                assign item_key = item_parts[0]
                assign item_name = item_parts[3]
                assign item_url = item_parts[4]
              -%}
              {%- if item_key != country_key or item_name == blank -%}
                {%- continue -%}
              {%- endif -%}
              <li>
                {%- if item_url != blank -%}
                  <a class="producer-index__link" href="{{ item_url }}">{{ item_name | escape }}</a>
                {%- else -%}
                  <span class="producer-index__name">{{ item_name | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="producer-index__empty">{{ 'producer_index.empty' | t }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .producer-index-section.shopify-section .section-background,
  .producer-index__backdrop {
    background-color: #eadec6;
  }

  .producer-index.section {
    row-gap: 0;
    padding-top: 24px;
    padding-bottom: 80px;
    color: #1a1a1a;
  }

  .producer-index__heading {
    margin: 0 0 36px;
    color: #1a1a1a;
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: normal;
    text-transform: none;
  }

  .producer-index__groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 40px;
  }

  .producer-index__country {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    padding-bottom: 8px;
    border-bottom: 1px solid rgb(26 26 26 / 0.55);
    color: #1a1a1a;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 11px;
    font-style: normal;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: normal;
    text-transform: uppercase;
  }

  .producer-index__country-name {
    letter-spacing: 0.12em;
  }

  .producer-index__count {
    letter-spacing: 0.06em;
  }

  .producer-index__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
  }

  .producer-index__link,
  .producer-index__name {
    color: #1a1a1a;
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.3;
    text-decoration: none;
    overflow-wrap: break-word;
  }

  .producer-index__link:hover,
  .producer-index__link:focus-visible {
    color: #7a2124;
    font-style: italic;
  }

  .producer-index__link:focus-visible {
    outline: 2px solid #1a1a1a;
    outline-offset: 3px;
  }

  .producer-index__empty {
    margin: 0;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 16px;
    line-height: 1.4;
  }

  @media screen and (min-width: 750px) {
    .producer-index.section {
      padding-top: 16px;
      padding-bottom: 96px;
    }

    .producer-index__heading {
      margin-bottom: 48px;
      font-size: 36px;
    }

    .producer-index__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 40px;
    }
  }

  @media screen and (min-width: 990px) {
    .producer-index__groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1200px) {
    .producer-index__groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 56px 48px;
    }
  }

  @media screen and (min-width: 1400px) {
    .producer-index__groups {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.producer_index",
  "tag": "section",
  "class": "producer-index-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.producer_index"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Alle producenter"
    },
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "t:settings.map_metaobject_type",
      "default": "producer"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "t:names.producer_index",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
