{% render 'product-specs-board',
  product_resource: product,
  board_id: section.id,
  is_section: true,
  section_width: section.settings.section_width,
  show_on_mobile: section.settings.show_on_mobile,
  show_on_desktop: section.settings.show_on_desktop
%}

{% schema %}
{
  "name": "t:names.product_specs",
  "tag": "section",
  "class": "product-specs-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.product_specs"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "t:settings.show_on_mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "t:settings.show_on_desktop",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:names.product_specs",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
