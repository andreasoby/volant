<style>
  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-sans-ext-400.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-sans-400.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'IBM Plex Serif';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-serif-ext-400.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'IBM Plex Serif';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-serif-400.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
</style>

{%- liquid
  assign metaobject_type = section.settings.metaobject_type | default: 'restaurant'
  assign selected_region = section.settings.region
  assign region_name = ''
  if selected_region != blank
    assign region_name = selected_region.name.value | default: selected_region.label.value | strip
    if region_name == blank
      assign region_name = selected_region.system.handle | replace: '-', ' ' | replace: '_', ' '
    endif
  endif
  assign catalog = ''
  assign offsets = '0,50,100,150,200' | split: ','
-%}

{%- if selected_region != blank -%}
  {%- paginate shop.metaobjects[metaobject_type].values by 250 -%}
    {%- for offset in offsets -%}
      {%- assign page_offset = offset | plus: 0 -%}
      {%- for restaurant in shop.metaobjects[metaobject_type].values limit: 50 offset: page_offset -%}
        {%- capture row -%}
          {%- render 'restaurant-index-name', restaurant: restaurant, region: selected_region -%}
        {%- endcapture -%}
        {%- assign row = row | strip -%}
        {%- if row != blank -%}
          {%- if catalog != blank -%}
            {%- assign catalog = catalog | append: '~|~' -%}
          {%- endif -%}
          {%- assign catalog = catalog | append: row -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endpaginate -%}
{%- endif -%}

{%- if catalog != blank -%}
  {%- assign rows = catalog | split: '~|~' | sort_natural -%}
{%- endif -%}

{%- if selected_region != blank or request.design_mode -%}
<div class="section-background restaurant-index__backdrop"></div>

<div
  class="section section--{{ section.settings.section_width }} restaurant-index"
  {% if region_name != blank %}
    aria-labelledby="RestaurantIndex-{{ section.id }}"
  {% else %}
    aria-label="{{ 'restaurant_index.label' | t }}"
  {% endif %}
>
  {%- if selected_region == blank -%}
    <p class="restaurant-index__empty">{{ 'restaurant_index.empty' | t }}</p>
  {%- else -%}
    <div class="restaurant-index__panel">
      <h2 id="RestaurantIndex-{{ section.id }}" class="restaurant-index__heading">
        <span class="restaurant-index__title">{{ region_name | escape }}</span>
        <span class="restaurant-index__count">{{ rows.size | default: 0 }}</span>
      </h2>

      {%- if catalog != blank -%}
        <ul class="restaurant-index__list list-unstyled">
          {%- for row in rows -%}
            {%- assign restaurant_name = row | split: '~^~' | last -%}
            {%- if restaurant_name != blank -%}
              <li class="restaurant-index__name">{{ restaurant_name | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="restaurant-index__none">{{ 'restaurant_index.none' | t }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
{%- endif -%}

{% stylesheet %}
  .restaurant-index-section.shopify-section .section-background,
  .restaurant-index__backdrop {
    background-color: #eadec6;
  }

  .restaurant-index.section {
    row-gap: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: #111;
  }

  .restaurant-index__panel {
    border-top: 1px solid #111;
    padding-top: 20px;
    padding-bottom: 40px;
  }

  .restaurant-index__heading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 20px;
    color: #111;
    font-weight: 400;
  }

  .restaurant-index__title {
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 22px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: normal;
  }

  .restaurant-index__count {
    color: #6b6357;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: normal;
  }

  .restaurant-index__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 12px;
  }

  .restaurant-index__name {
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 15px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .restaurant-index__empty,
  .restaurant-index__none {
    margin: 0;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.4;
  }

  .restaurant-index__empty {
    padding-top: 20px;
    padding-bottom: 40px;
  }

  @media screen and (min-width: 750px) {
    .restaurant-index__panel {
      padding-bottom: 48px;
    }

    .restaurant-index__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.restaurant_index",
  "tag": "section",
  "class": "restaurant-index-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.restaurant_index"
    },
    {
      "type": "metaobject",
      "id": "region",
      "label": "t:settings.restaurant_region",
      "metaobject_type": "region"
    },
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "t:settings.map_metaobject_type",
      "default": "restaurant"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "t:names.restaurant_index",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
