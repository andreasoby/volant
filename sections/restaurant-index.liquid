<style>
  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-sans-ext-400.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-sans-400.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'IBM Plex Serif';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-serif-ext-400.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'IBM Plex Serif';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'ibm-plex-serif-400.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
</style>

{%- capture matched_region_handle -%}
  {%- assign region_setting = section.settings.region | append: '' | strip -%}
  {%- if section.settings.region.system.handle == blank and region_setting contains 'gid://shopify/Metaobject/' -%}
    {%- assign region_id = region_setting | split: '/' | last | strip -%}
    {%- for region_candidate in shop.metaobjects.restaurant_region.values -%}
      {%- assign candidate_id = region_candidate.system.id | append: '' -%}
      {%- if candidate_id == region_id -%}
        {{- region_candidate.system.handle -}}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign matched_region_handle = matched_region_handle | strip -%}
{%- if matched_region_handle != blank -%}
  {%- assign selected_region = shop.metaobjects.restaurant_region[matched_region_handle] -%}
{%- elsif section.settings.region.system.handle != blank -%}
  {%- assign selected_region = section.settings.region -%}
{%- else -%}
  {%- assign region_setting = section.settings.region | append: '' | strip -%}
  {%- if region_setting != blank and region_setting contains 'gid://shopify/Metaobject/' -%}
    {%- assign selected_region = blank -%}
  {%- else -%}
    {%- assign selected_region = shop.metaobjects.restaurant_region[region_setting] -%}
  {%- endif -%}
{%- endif -%}

{%- liquid
  assign metaobject_type = section.settings.metaobject_type | default: 'restaurant'
  if selected_region != blank
    assign region_name = selected_region.name.value | default: selected_region.label.value | strip
    if region_name == blank
      assign region_name = selected_region.system.handle | replace: '-', ' ' | replace: '_', ' '
    endif
  endif
  assign catalog = ''
  assign offsets = '0,50,100,150,200' | split: ','
-%}

{%- if selected_region != blank -%}
  {%- paginate shop.metaobjects[metaobject_type].values by 250 -%}
    {%- for offset in offsets -%}
      {%- assign page_offset = offset | plus: 0 -%}
      {%- for restaurant in shop.metaobjects[metaobject_type].values limit: 50 offset: page_offset -%}
        {%- capture row -%}
          {%- render 'restaurant-index-name', restaurant: restaurant, region: selected_region -%}
        {%- endcapture -%}
        {%- assign row = row | strip -%}
        {%- if row != blank -%}
          {%- if catalog != blank -%}
            {%- assign catalog = catalog | append: '~|~' -%}
          {%- endif -%}
          {%- assign catalog = catalog | append: row -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endpaginate -%}
{%- endif -%}

{%- if catalog != blank -%}
  {%- assign rows = catalog | split: '~|~' | sort_natural -%}
{%- endif -%}

{%- if selected_region != blank or request.design_mode -%}
<div class="section-background restaurant-index__backdrop"></div>

<div
  class="section section--{{ section.settings.section_width }} restaurant-index"
  {% if region_name != blank %}
    aria-labelledby="RestaurantIndex-{{ section.id }}"
  {% else %}
    aria-label="{{ 'restaurant_index.label' | t }}"
  {% endif %}
>
  {%- if selected_region == blank -%}
    <p class="restaurant-index__empty">{{ 'restaurant_index.empty' | t }}</p>
  {%- else -%}
    <div class="restaurant-index__panel">
      <h2 id="RestaurantIndex-{{ section.id }}" class="restaurant-index__heading">
        <span class="restaurant-index__title">{{ region_name | escape }}</span>
        <span class="restaurant-index__count">{{ rows.size | default: 0 }}</span>
      </h2>

      {%- if catalog != blank -%}
        <ul class="restaurant-index__list list-unstyled">
          {%- for row in rows -%}
            {%- assign restaurant_parts = row | split: '~^~' -%}
            {%- assign restaurant_name = restaurant_parts[1] -%}
            {%- assign restaurant_image = restaurant_parts[2] -%}
            {%- if restaurant_name != blank -%}
              <li class="restaurant-index__item">
                <button type="button" class="restaurant-index__name">{{ restaurant_name | escape }}</button>
                {%- if restaurant_image != blank -%}
                  <span class="restaurant-index__preview" aria-hidden="true">
                    <img
                      src="{{ restaurant_image | escape }}"
                      alt=""
                      width="1200"
                      height="500"
                      loading="lazy"
                    >
                    <span class="restaurant-index__caption">
                      <span class="restaurant-index__caption-title">{{ restaurant_name | escape }}</span>
                      {%- if region_name != blank -%}
                        <span class="restaurant-index__caption-region">{{ region_name | escape }}</span>
                      {%- endif -%}
                    </span>
                  </span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="restaurant-index__none">{{ 'restaurant_index.none' | t }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
{%- endif -%}

{% stylesheet %}
  .restaurant-index-section.shopify-section .section-background,
  .restaurant-index__backdrop {
    background-color: #eadec6;
  }

  .restaurant-index.section {
    row-gap: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: #111;
    overflow: visible;
  }

  .restaurant-index__panel {
    border-top: 1px solid #111;
    padding-top: 20px;
    padding-bottom: 40px;
  }

  .restaurant-index__heading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 20px;
    color: #111;
    font-weight: 400;
  }

  .restaurant-index__title {
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 22px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: normal;
  }

  .restaurant-index__count {
    color: #6b6357;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: normal;
  }

  .restaurant-index__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 12px;
    overflow: visible;
  }

  .restaurant-index__item {
    position: relative;
    min-width: 0;
  }

  .restaurant-index__name {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 15px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: normal;
    text-align: left;
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .restaurant-index__name:focus-visible {
    outline: 2px solid #111;
    outline-offset: 3px;
  }

  .restaurant-index__preview {
    display: none;
    position: absolute;
    z-index: 3;
    left: 0;
    bottom: calc(100% + 10px);
    width: min(420px, 72vw);
    aspect-ratio: 12 / 5;
    pointer-events: none;
    overflow: hidden;
    background: #2a2118;
  }

  .restaurant-index__preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .restaurant-index__preview::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 58%;
    background: linear-gradient(to top, rgb(0 0 0 / 48%), transparent);
  }

  .restaurant-index__caption {
    position: absolute;
    z-index: 1;
    left: 16px;
    right: 16px;
    bottom: 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: #fff;
    text-shadow: 0 1px 10px rgb(0 0 0 / 45%);
  }

  .restaurant-index__caption-title {
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 28px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.05;
  }

  .restaurant-index__caption-region {
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.2;
  }

  @media (hover: hover) {
    .restaurant-index__item:hover .restaurant-index__preview {
      display: block;
    }
  }

  .restaurant-index__item:focus-within .restaurant-index__preview {
    display: block;
  }

  .restaurant-index__empty,
  .restaurant-index__none {
    margin: 0;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.4;
  }

  .restaurant-index__empty {
    padding-top: 20px;
    padding-bottom: 40px;
  }

  @media screen and (min-width: 750px) {
    .restaurant-index__panel {
      padding-bottom: 48px;
    }

    .restaurant-index__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.restaurant_index",
  "tag": "section",
  "class": "restaurant-index-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.restaurant_index"
    },
    {
      "type": "metaobject",
      "id": "region",
      "label": "t:settings.restaurant_region",
      "metaobject_type": "restaurant_region"
    },
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "t:settings.map_metaobject_type",
      "default": "restaurant"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "t:names.restaurant_index",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
