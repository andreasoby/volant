{%- doc -%}
  Outputs true when the current visitor should see the "ekskl. moms" note (see vat-note).
  Prices aren't changed: the B2B catalogs already hold ex-VAT prices.

  The note is only shown when the session's prices exclude tax (cart.taxes_included is false), so a
  B2B customer in a session using the Danmark catalog doesn't see VAT-inclusive prices marked "ekskl. moms".
  Within that, a visitor is an ex-VAT visitor when either:
  - their market handle is in the "B2B / ex-VAT prices" market handle list (default: b2b, virksomheder), or
  - they are a signed-in B2B customer and "Show ex-VAT prices to B2B customers" isn't turned off.
    A customer counts as B2B when Shopify flags the session as B2B (customer.b2b?) or the customer
    is a contact on any company location. The second check covers company locations that are also in
    a D2C market (e.g. Danmark), where Shopify can put the customer in a regular D2C session.

  Settings may be nil until the theme settings are saved, so the schema defaults are repeated here.

  @example
  {% capture ex_vat %}{% render 'ex-vat-market' %}{% endcapture %}
  {% if ex_vat contains 'true' %}...{% endif %}
{%- enddoc -%}

{%- liquid
  assign is_ex_vat = false

  assign market_handles = settings.ex_vat_market_handles
  if market_handles == nil
    assign market_handles = 'b2b, virksomheder'
  endif

  assign current_market = localization.market.handle | downcase
  if current_market != blank
    assign market_list = market_handles | downcase | split: ','
    for market_handle in market_list
      assign market_handle = market_handle | strip
      if market_handle != blank and market_handle == current_market
        assign is_ex_vat = true
        break
      endif
    endfor
  endif

  if customer and settings.ex_vat_for_b2b_customers != false
    assign company_location_count = customer.company_available_locations_count | default: 0
    if customer.b2b? or customer.current_company != blank or company_location_count > 0
      assign is_ex_vat = true
    endif
  endif

  if is_ex_vat and cart.taxes_included == false
    echo 'true'
  endif
-%}
