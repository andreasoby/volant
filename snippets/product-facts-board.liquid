{%- liquid
  assign producer_field = fact_product.metafields.custom.producer
  assign grape_field = fact_product.metafields.custom.grape
  assign vintage_field = fact_product.metafields.custom.vintage
  assign country_field = fact_product.metafields.custom.country
  assign region_field = fact_product.metafields.custom.region
  assign type_field = fact_product.metafields.custom.type
  assign note_field = fact_product.metafields.custom.vintage_note
  assign note_title_field = fact_product.metafields.custom.vintage_note_title
-%}

{%- capture producer_text -%}{%- render 'product-fact-text', metafield: producer_field -%}{%- endcapture -%}
{%- capture grape_text -%}{%- render 'product-fact-text', metafield: grape_field -%}{%- endcapture -%}
{%- capture vintage_text -%}{%- render 'product-fact-text', metafield: vintage_field -%}{%- endcapture -%}
{%- capture country_text -%}{%- render 'product-fact-text', metafield: country_field -%}{%- endcapture -%}
{%- capture region_text -%}{%- render 'product-fact-text', metafield: region_field -%}{%- endcapture -%}
{%- capture type_text -%}{%- render 'product-fact-text', metafield: type_field -%}{%- endcapture -%}

{%- liquid
  assign producer_text = producer_text | strip
  assign grape_text = grape_text | strip
  assign vintage_text = vintage_text | strip
  assign country_text = country_text | strip
  assign region_text = region_text | strip
  assign type_text = type_text | strip
  assign producer_url = ''
  assign note_text = ''
  assign note_title = ''

  assign has_facts = false
  if producer_text != blank or grape_text != blank or vintage_text != blank or country_text != blank or region_text != blank or type_text != blank or note_field != blank
    assign has_facts = true
  endif

  if has_facts
    if note_field.type == 'rich_text_field'
      assign note_text = note_field | metafield_text | strip
    else
      assign note_text = note_field.value | strip
    endif

    assign note_title = note_title_field.value | strip
    if note_title == blank and note_text != blank
      if vintage_text != blank
        assign note_title = 'product_facts.vintage_title' | t: year: vintage_text
      else
        assign note_title = 'product_facts.vintage' | t
      endif
    endif

    assign producer_url = fact_product.metafields.custom.producer_url.value
    if producer_url == blank and producer_field.type == 'page_reference'
      assign producer_url = producer_field.value.url
    endif
    if producer_url == blank and producer_field.type == 'metaobject_reference'
      assign producer_entry = producer_field.value
      if producer_entry.system.url != blank
        assign producer_url = producer_entry.system.url
      elsif producer_entry.url.value != blank
        assign producer_url = producer_entry.url.value
      elsif producer_entry.link.value != blank
        assign producer_url = producer_entry.link.value
      endif
    endif
  else
    assign producer_text = 'product_facts.sample.producer' | t
    assign grape_text = 'product_facts.sample.grape' | t
    assign vintage_text = 'product_facts.sample.vintage' | t
    assign country_text = 'product_facts.sample.country' | t
    assign region_text = 'product_facts.sample.region' | t
    assign type_text = 'product_facts.sample.type' | t
    assign note_text = 'product_facts.sample.note' | t
    assign note_title = 'product_facts.sample.note_title' | t
  endif
-%}

<div class="product-facts-root{{ facts_visibility }}">
  {%- if is_section -%}
    <div class="section-background product-facts__backdrop"></div>
  {%- endif -%}

<div
  class="{% if is_section %}section section--{{ facts_width }}{% else %}product-facts--block{% endif %} product-facts"
  aria-label="{{ 'product_facts.label' | t }}"
>
  <details class="product-facts__details">
    <summary class="product-facts__summary">
      <span>{{ 'product_facts.label' | t }}</span>
      <span class="product-facts__plus" aria-hidden="true">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>
    <dl class="product-facts__board">
    <div class="product-facts__cell">
      <dt class="product-facts__label">{{ 'product_facts.producer' | t }}</dt>
      <dd class="product-facts__value">
        {%- if producer_text != blank -%}
          {%- if producer_url != blank -%}
            <a class="product-facts__producer" href="{{ producer_url }}">{{ producer_text }}</a>
          {%- else -%}
            <span class="product-facts__producer">{{ producer_text }}</span>
          {%- endif -%}
        {%- endif -%}
      </dd>
    </div>

    <div class="product-facts__cell">
      <dt class="product-facts__label">{{ 'product_facts.grape' | t }}</dt>
      <dd class="product-facts__value">{{ grape_text }}</dd>
    </div>

    <div class="product-facts__cell">
      <dt class="product-facts__label">
        {%- if note_text != blank -%}
          <product-fact-info class="product-facts__info">
            <span>{{ 'product_facts.vintage' | t }}</span>
            <button
              type="button"
              class="product-facts__info-button"
              aria-expanded="false"
              aria-describedby="ProductFactsNote-{{ board_id }}"
            >
              <span aria-hidden="true">i</span>
              <span class="visually-hidden">
                {{ 'product_facts.vintage_info' | t: year: vintage_text }}
              </span>
            </button>
            <div class="product-facts__tooltip" id="ProductFactsNote-{{ board_id }}" role="tooltip">
              {%- if note_title != blank -%}
                <p class="product-facts__tooltip-title">{{ note_title }}</p>
              {%- endif -%}
              <p class="product-facts__tooltip-body">{{ note_text }}</p>
            </div>
          </product-fact-info>
        {%- else -%}
          {{ 'product_facts.vintage' | t }}
        {%- endif -%}
      </dt>
      <dd class="product-facts__value">{{ vintage_text }}</dd>
    </div>

    <div class="product-facts__cell">
      <dt class="product-facts__label">{{ 'product_facts.country' | t }}</dt>
      <dd class="product-facts__value">{{ country_text }}</dd>
    </div>

    <div class="product-facts__cell">
      <dt class="product-facts__label">{{ 'product_facts.region' | t }}</dt>
      <dd class="product-facts__value">{{ region_text }}</dd>
    </div>

    <div class="product-facts__cell">
      <dt class="product-facts__label">{{ 'product_facts.type' | t }}</dt>
      <dd class="product-facts__value">{{ type_text }}</dd>
    </div>
    </dl>
  </details>
</div>
</div>

{% stylesheet %}
  .product-facts-section.shopify-section .section-background,
  .product-facts__backdrop {
    background-color: #eadec6;
  }

  .product-facts.section {
    padding-top: 48px;
    padding-bottom: 48px;
    color: #111;
  }

  .product-facts-block,
  .product-facts--block {
    width: 100%;
    min-width: 0;
    color: #111;
  }

  .product-facts__details {
    width: 100%;
    min-width: 0;
  }

  .product-facts__summary {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding: 14px 0;
    border-top: 1px solid #111;
    border-bottom: 1px solid #111;
    list-style: none;
    cursor: pointer;
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
  }

  .product-facts__summary::-webkit-details-marker {
    display: none;
  }

  .product-facts__summary:focus-visible {
    outline: 2px solid #111;
    outline-offset: 2px;
  }

  .product-facts__plus {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    color: #111;
  }

  .product-facts__plus svg {
    display: block;
  }

  .product-facts__plus :is(.horizontal, .vertical) {
    transform-origin: 50% 50%;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .product-facts__details[open] > .product-facts__summary .product-facts__plus .horizontal {
    transform: rotate(90deg);
  }

  .product-facts__details[open] > .product-facts__summary .product-facts__plus .vertical {
    transform: rotate(90deg);
    opacity: 0;
  }

  .product-facts__details::details-content {
    display: block !important;
    height: auto !important;
    content-visibility: visible !important;
  }

  .product-facts__details > .product-facts__board {
    display: grid !important;
  }

  .product-facts__board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin: 0;
    border-top: 1px solid #111;
  }

  .product-facts__cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
    margin: 0;
    padding: 14px 12px 14px 16px;
    border-bottom: 1px solid #111;
    border-left: 1px solid #111;
  }

  .product-facts__cell:nth-child(3n + 1) {
    padding-left: 0;
    border-left: 0;
  }

  .product-facts__label {
    margin: 0;
    color: #6b6357;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    letter-spacing: 0.72px;
    text-transform: uppercase;
  }

  .product-facts__info {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .product-facts__info:hover,
  .product-facts__info:focus-within,
  .product-facts__info.is-open {
    z-index: 4;
  }

  .product-facts__value {
    width: 100%;
    margin: 0;
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
  }

  .product-facts__producer {
    color: #111;
    font: inherit;
    text-decoration: underline;
    text-decoration-color: currentcolor;
    text-decoration-thickness: from-font;
    text-underline-offset: from-font;
    text-underline-position: from-font;
  }

  a.product-facts__producer:hover {
    color: #6b6357;
  }

  .product-facts__info-button {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(26, 26, 26, 0.45);
    border-radius: 7px;
    background: transparent;
    color: rgba(26, 26, 26, 0.6);
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 9px;
    font-style: normal;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
    appearance: none;
  }

  .product-facts__info:hover .product-facts__info-button,
  .product-facts__info:focus-within .product-facts__info-button,
  .product-facts__info.is-open .product-facts__info-button {
    border-color: #1a1a1a;
    background: #1a1a1a;
    color: #eadec6;
  }

  .product-facts__info-button:focus-visible {
    outline: 2px solid #111;
    outline-offset: 2px;
  }

  .product-facts__tooltip {
    position: absolute;
    bottom: 28px;
    left: -17px;
    z-index: 3;
    display: none;
    flex-direction: column;
    gap: 8px;
    width: 194px;
    margin: 0;
    padding: 18px 16px;
    background: #1a1a1a;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
    color: #eadec6;
    letter-spacing: normal;
    text-transform: none;
  }

  .product-facts__tooltip::before {
    content: '';
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    height: 14px;
  }

  .product-facts__info:hover .product-facts__tooltip,
  .product-facts__info:focus-within .product-facts__tooltip,
  .product-facts__info.is-open .product-facts__tooltip {
    display: flex;
  }

  .product-facts__tooltip-title,
  .product-facts__tooltip-body {
    margin: 0;
    letter-spacing: normal;
    text-transform: none;
  }

  .product-facts__tooltip-title {
    color: #eadec6;
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 17px;
    font-style: italic;
    font-weight: 400;
    line-height: normal;
  }

  .product-facts__tooltip-body {
    color: rgba(234, 222, 198, 0.85);
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 13px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5;
    white-space: pre-line;
  }

  @media screen and (max-width: 749px) {
    .product-facts.section {
      padding-top: 24px;
      padding-bottom: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .product-facts-section:has(.product-facts--hide-mobile),
    .product-facts--hide-mobile {
      display: none !important;
    }
  }

  @media screen and (min-width: 750px) {
    .product-facts-section:has(.product-facts--hide-desktop),
    .product-facts--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .product-facts__summary {
      display: flex;
    }

    .product-facts__details:not([open])::details-content,
    .product-facts__details:not([open]) > .product-facts__board {
      display: none !important;
      height: 0 !important;
      content-visibility: hidden !important;
    }

    .product-facts__details[open] > .product-facts__summary {
      border-bottom: 0;
    }

    .product-facts__board {
      grid-template-columns: 1fr;
      border-top: 0;
    }

    .product-facts__details[open] > .product-facts__board {
      border-top: 1px solid #111;
    }

    .product-facts__cell {
      padding-left: 0;
      border-left: 0;
    }

    .product-facts__tooltip {
      left: 0;
      width: min(194px, calc(100vw - 48px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-facts__plus :is(.horizontal, .vertical) {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ProductFactInfo extends HTMLElement {
    connectedCallback() {
      this.button = this.querySelector('button');
      this.onClick = this.onClick.bind(this);
      this.onKeydown = this.onKeydown.bind(this);
      this.onPointerDown = this.onPointerDown.bind(this);
      this.button?.addEventListener('click', this.onClick);
    }

    disconnectedCallback() {
      this.button?.removeEventListener('click', this.onClick);
      this.unbind();
    }

    onClick() {
      const open = this.classList.toggle('is-open');
      this.button?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        document.addEventListener('keydown', this.onKeydown);
        document.addEventListener('pointerdown', this.onPointerDown);
      } else {
        this.unbind();
      }
    }

    onKeydown(event) {
      if (event.key !== 'Escape') return;
      this.close();
      this.button?.focus();
    }

    onPointerDown(event) {
      if (!this.contains(event.target)) this.close();
    }

    close() {
      this.classList.remove('is-open');
      this.button?.setAttribute('aria-expanded', 'false');
      this.unbind();
    }

    unbind() {
      document.removeEventListener('keydown', this.onKeydown);
      document.removeEventListener('pointerdown', this.onPointerDown);
    }
  }

  if (!customElements.get('product-fact-info')) {
    customElements.define('product-fact-info', ProductFactInfo);
  }
{% endjavascript %}
