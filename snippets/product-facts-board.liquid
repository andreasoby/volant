{% doc %}
  Product facts board, shared by the product facts section and block.

  @param {object} product_resource - Product whose metafields fill the board
  @param {string} board_id - Unique id for the vintage note
  @param {boolean} [is_section] - Renders the page-width section frame when true
  @param {string} [section_width] - Section width setting
  @param {boolean} [show_on_mobile] - Visible below 750px. Defaults to true
  @param {boolean} [show_on_desktop] - Visible from 750px. Defaults to true
{% enddoc %}

{%- liquid
  assign fact_product = product_resource
  if fact_product == blank
    assign fact_product = closest.product | default: product
  endif
  assign board_id = board_id | default: section.id
  assign facts_width = section_width | default: 'page-width'
  assign facts_visibility = ''
  if show_on_mobile == false
    assign facts_visibility = facts_visibility | append: ' product-facts--hide-mobile'
  endif
  if show_on_desktop == false
    assign facts_visibility = facts_visibility | append: ' product-facts--hide-desktop'
  endif
-%}

