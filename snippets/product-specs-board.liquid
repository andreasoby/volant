</style>

{%- liquid
  assign lagring_field = spec_product.metafields.custom.lagring
  assign added_so2_field = spec_product.metafields.custom.added_so2
  assign bottle_count_field = spec_product.metafields.custom.bottle_count
  assign alcohol_field = spec_product.metafields.custom.alcohol
  assign farming_field = spec_product.metafields.custom.farming
  assign size_field = spec_product.metafields.custom.bottle_size
-%}

{%- capture lagring_text -%}{%- render 'product-fact-text', metafield: lagring_field -%}{%- endcapture -%}
{%- capture added_so2_text -%}{%- render 'product-fact-text', metafield: added_so2_field -%}{%- endcapture -%}
{%- capture bottle_count_text -%}{%- render 'product-fact-text', metafield: bottle_count_field -%}{%- endcapture -%}
{%- capture alcohol_text -%}{%- render 'product-fact-text', metafield: alcohol_field -%}{%- endcapture -%}
{%- capture farming_text -%}{%- render 'product-fact-text', metafield: farming_field -%}{%- endcapture -%}
{%- capture size_text -%}{%- render 'product-fact-text', metafield: size_field -%}{%- endcapture -%}

{%- liquid
  assign lagring_text = lagring_text | strip
  assign added_so2_text = added_so2_text | strip
  assign bottle_count_text = bottle_count_text | strip
  assign alcohol_text = alcohol_text | strip
  assign farming_text = farming_text | strip
  assign size_text = size_text | strip
  assign lagring_note = ''
  assign added_so2_note = ''

  assign has_specs = false
  if lagring_text != blank or added_so2_text != blank or bottle_count_text != blank or alcohol_text != blank or farming_text != blank or size_text != blank
    assign has_specs = true
  endif

  if has_specs
    assign lagring_note_field = spec_product.metafields.custom.lagring_note
    assign added_so2_note_field = spec_product.metafields.custom.added_so2_note
    if lagring_note_field.type == 'rich_text_field'
      assign lagring_note = lagring_note_field | metafield_text | strip
    else
      assign lagring_note = lagring_note_field.value | strip
    endif
    if added_so2_note_field.type == 'rich_text_field'
      assign added_so2_note = added_so2_note_field | metafield_text | strip
    else
      assign added_so2_note = added_so2_note_field.value | strip
    endif
  else
    assign lagring_text = 'product_specs.sample.lagring' | t
    assign added_so2_text = 'product_specs.sample.added_so2' | t
    assign bottle_count_text = 'product_specs.sample.bottle_count' | t
    assign alcohol_text = 'product_specs.sample.alcohol' | t
    assign farming_text = 'product_specs.sample.farming' | t
    assign size_text = 'product_specs.sample.size' | t
  endif

  assign lagring_label = 'product_specs.lagring' | t
  assign added_so2_label = 'product_specs.added_so2' | t
  assign bottle_count_label = 'product_specs.bottle_count' | t
  assign alcohol_label = 'product_specs.alcohol' | t
  assign farming_label = 'product_specs.farming' | t
  assign size_label = 'product_specs.size' | t
-%}

<div class="product-specs-root{{ specs_visibility }}">
  {%- if is_section -%}
    <div class="section-background product-specs__backdrop"></div>
  {%- endif -%}

<div
  class="{% if is_section %}section section--{{ specs_width }}{% else %}product-specs--block{% endif %} product-specs"
  aria-label="{{ 'product_specs.label' | t }}"
>
  <details class="product-specs__details">
    <summary class="product-specs__summary">
      <span>{{ 'product_specs.label' | t }}</span>
      <span class="product-specs__plus" aria-hidden="true">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="product-specs__grid">
      {% render 'product-spec-item',
        board_id: board_id,
        label: lagring_label,
        value: lagring_text,
        field_id: 'lagring',
        note: lagring_note,
        note_title: lagring_label
      %}
      {% render 'product-spec-item',
        board_id: board_id,
        label: added_so2_label,
        value: added_so2_text,
        field_id: 'added_so2',
        note: added_so2_note,
        note_title: added_so2_label
      %}
      {% render 'product-spec-item',
        board_id: board_id,
        label: bottle_count_label,
        value: bottle_count_text,
        field_id: 'bottle_count'
      %}
      {% render 'product-spec-item',
        board_id: board_id,
        label: alcohol_label,
        value: alcohol_text,
        field_id: 'alcohol'
      %}
      {% render 'product-spec-item',
        board_id: board_id,
        label: farming_label,
        value: farming_text,
        field_id: 'farming'
      %}
      {% render 'product-spec-item',
        board_id: board_id,
        label: size_label,
        value: size_text,
        field_id: 'size'
      %}
    </div>
  </details>
</div>
</div>

{% stylesheet %}
  .product-specs-section.shopify-section .section-background,
  .product-specs__backdrop {
    background-color: #eadec6;
  }

  .product-specs.section {
    padding-top: 48px;
    padding-bottom: 48px;
    color: #111;
  }

  .product-specs-block,
  .product-specs--block {
    width: 100%;
    min-width: 0;
    color: #111;
  }

  .product-specs__details {
    width: 100%;
    min-width: 0;
  }

  .product-specs__summary {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding: 14px 0;
    border-top: 1px solid #111;
    border-bottom: 1px solid #111;
    list-style: none;
    cursor: pointer;
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
  }

  .product-specs__summary::-webkit-details-marker {
    display: none;
  }

  .product-specs__summary:focus-visible {
    outline: 2px solid #111;
    outline-offset: 2px;
  }

  .product-specs__plus {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    color: #111;
  }

  .product-specs__plus svg {
    display: block;
  }

  .product-specs__plus :is(.horizontal, .vertical) {
    transform-origin: 50% 50%;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .product-specs__details[open] > .product-specs__summary .product-specs__plus .horizontal {
    transform: rotate(90deg);
  }

  .product-specs__details[open] > .product-specs__summary .product-specs__plus .vertical {
    transform: rotate(90deg);
    opacity: 0;
  }

  .product-specs__details::details-content {
    display: block !important;
    height: auto !important;
    content-visibility: visible !important;
  }

  .product-specs__details > .product-specs__grid {
    display: grid !important;
  }

  .product-specs__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: 100%;
    margin: 0;
    border-top: 1px solid #111;
    border-left: 1px solid #111;
  }

  .product-specs__item {
    display: contents;
  }

  .product-specs__label,
  .product-specs__value {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    min-height: 43px;
    margin: 0;
    padding: 12px;
    border-right: 1px solid #111;
    border-bottom: 1px solid #111;
    color: #111;
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 14px;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
  }

  .product-specs__label {
    font-weight: 500;
  }

  .product-specs__value {
    font-weight: 400;
  }

  .product-specs__info {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    z-index: 1;
  }

  .product-specs__info:hover,
  .product-specs__info:focus-within,
  .product-specs__info.is-open {
    z-index: 4;
  }

  .product-specs__info-button {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(26, 26, 26, 0.45);
    border-radius: 7px;
    background: transparent;
    color: rgba(26, 26, 26, 0.6);
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 9px;
    font-style: normal;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
    appearance: none;
  }

  span.product-specs__info-button {
    cursor: default;
  }

  .product-specs__info:hover .product-specs__info-button,
  .product-specs__info:focus-within .product-specs__info-button,
  .product-specs__info.is-open .product-specs__info-button {
    border-color: #1a1a1a;
    background: #1a1a1a;
    color: #eadec6;
  }

  .product-specs__info-button:focus-visible {
    outline: 2px solid #111;
    outline-offset: 2px;
  }

  .product-specs__tooltip {
    position: absolute;
    bottom: 28px;
    left: -17px;
    z-index: 3;
    display: none;
    flex-direction: column;
    gap: 8px;
    width: 194px;
    margin: 0;
    padding: 18px 16px;
    background: #1a1a1a;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
    color: #eadec6;
    letter-spacing: normal;
    text-transform: none;
  }

  .product-specs__tooltip::before {
    content: '';
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    height: 14px;
  }

  .product-specs__info:hover .product-specs__tooltip,
  .product-specs__info:focus-within .product-specs__tooltip,
  .product-specs__info.is-open .product-specs__tooltip {
    display: flex;
  }

  .product-specs__tooltip-title,
  .product-specs__tooltip-body {
    margin: 0;
    letter-spacing: normal;
    text-transform: none;
  }

  .product-specs__tooltip-title {
    color: #eadec6;
    font-family: 'IBM Plex Serif', var(--font-heading--family), serif;
    font-size: 17px;
    font-style: italic;
    font-weight: 400;
    line-height: normal;
  }

  .product-specs__tooltip-body {
    color: rgba(234, 222, 198, 0.85);
    font-family: 'IBM Plex Sans', var(--font-body--family), sans-serif;
    font-size: 13px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5;
    white-space: pre-line;
  }

  @media screen and (max-width: 749px) {
    .product-specs.section {
      padding-top: 24px;
      padding-bottom: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .product-specs-section:has(.product-specs--hide-mobile),
    .product-specs--hide-mobile {
      display: none !important;
    }
  }

  @media screen and (min-width: 750px) {
    .product-specs-section:has(.product-specs--hide-desktop),
    .product-specs--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .product-specs__summary {
      display: flex;
    }

    .product-specs__details:not([open])::details-content,
    .product-specs__details:not([open]) > .product-specs__grid {
      display: none !important;
      height: 0 !important;
      content-visibility: hidden !important;
    }

    .product-specs__details[open] > .product-specs__summary {
      border-bottom: 0;
    }

    .product-specs__details > .product-specs__grid {
      display: flex !important;
      flex-direction: column;
      border: 0;
    }

    .product-specs__details[open] > .product-specs__grid {
      border-top: 1px solid #111;
    }

    .product-specs__item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 14px 0;
      border-bottom: 1px solid #111;
    }

    .product-specs__label,
    .product-specs__value {
      min-height: 0;
      padding: 0;
      border: 0;
      line-height: normal;
    }

    .product-specs__label {
      color: #6b6357;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.72px;
      text-transform: uppercase;
    }

    .product-specs__value {
      width: 100%;
      color: #111;
      font-size: 16px;
      font-weight: 400;
    }

    .product-specs__tooltip {
      left: 0;
      width: min(194px, calc(100vw - 48px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-specs__plus :is(.horizontal, .vertical) {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ProductFactInfo extends HTMLElement {
    connectedCallback() {
      this.button = this.querySelector('button');
      if (!this.button) return;
      this.onClick = this.onClick.bind(this);
      this.onKeydown = this.onKeydown.bind(this);
      this.onPointerDown = this.onPointerDown.bind(this);
      this.button.addEventListener('click', this.onClick);
    }

    disconnectedCallback() {
      this.button?.removeEventListener('click', this.onClick);
      this.unbind();
    }

    onClick() {
      const open = this.classList.toggle('is-open');
      this.button?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        document.addEventListener('keydown', this.onKeydown);
        document.addEventListener('pointerdown', this.onPointerDown);
      } else {
        this.unbind();
      }
    }

    onKeydown(event) {
      if (event.key !== 'Escape') return;
      this.close();
      this.button?.focus();
    }

    onPointerDown(event) {
      if (!this.contains(event.target)) this.close();
    }

    close() {
      this.classList.remove('is-open');
      this.button?.setAttribute('aria-expanded', 'false');
      this.unbind();
    }

    unbind() {
      document.removeEventListener('keydown', this.onKeydown);
      document.removeEventListener('pointerdown', this.onPointerDown);
    }
  }

  if (!customElements.get('product-fact-info')) {
    customElements.define('product-fact-info', ProductFactInfo);
  }
{% endjavascript %}
