{% doc %}
  Product specifications board, shared by the product specs section and block.

  @param {object} product_resource - Product whose metafields fill the board
  @param {string} board_id - Unique id for the notes
  @param {boolean} [is_section] - Renders the page-width section frame when true
  @param {string} [section_width] - Section width setting
  @param {boolean} [show_on_mobile] - Visible below 750px. Defaults to true
  @param {boolean} [show_on_desktop] - Visible from 750px. Defaults to true
{% enddoc %}

{%- liquid
  assign spec_product = product_resource
  if spec_product == blank
    assign spec_product = closest.product | default: product
  endif
  assign board_id = board_id | default: section.id
  assign specs_width = section_width | default: 'page-width'
  assign specs_visibility = ''
  if show_on_mobile == false
    assign specs_visibility = specs_visibility | append: ' product-specs--hide-mobile'
  endif
  if show_on_desktop == false
    assign specs_visibility = specs_visibility | append: ' product-specs--hide-desktop'
  endif
-%}

<style>
