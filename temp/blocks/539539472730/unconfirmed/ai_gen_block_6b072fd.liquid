{% doc %}
  @prompt
    Create a collection card block with a manually selectable custom image and a collection picker for its destination. The custom image must apply only to this card and must not change the collection's featured image or other cards. If no custom image is selected, fall back to the selected collection's image. Match the current theme's collection-card styling, including title, image aspect ratio, overlay, borders, and responsive behavior. Make the image, collection destination, and title editable in the theme editor. Intended to replace a card in the collection list on /collections/alle-produkter.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign card_collection = block.settings.collection %}
{% assign card_image = block.settings.custom_image %}
{% if card_image == blank and card_collection != blank %}
  {% assign card_image = card_collection.featured_image %}
{% endif %}
{% assign card_title = block.settings.title %}
{% if card_title == blank and card_collection != blank %}
  {% assign card_title = card_collection.title %}
{% endif %}

{% style %}
  .ai-collection-card-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
  }
  .ai-collection-card-{{ ai_gen_id }}__link {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    color: #ffffff;
    background: #333333;
    border: 1px solid rgba(0, 0, 0, 0.16);
    text-decoration: none;
  }
  .ai-collection-card-{{ ai_gen_id }}__media,
  .ai-collection-card-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ai-collection-card-{{ ai_gen_id }}__media { object-fit: cover; }
  .ai-collection-card-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #dfdfdf;
  }
  .ai-collection-card-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; object-fit: cover; }
  .ai-collection-card-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.03) 35%, rgba(0,0,0,{{ block.settings.overlay_strength | divided_by: 100.0 }}) 100%);
  }
  .ai-collection-card-{{ ai_gen_id }}__title {
    position: absolute;
    z-index: 1;
    left: 20px;
    right: 20px;
    bottom: 18px;
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(20px, 2vw, 30px);
    font-weight: 400;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  .ai-collection-card-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid #000000; outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .ai-collection-card-{{ ai_gen_id }} { width: 100%; }
    .ai-collection-card-{{ ai_gen_id }}__title { left: 14px; right: 14px; bottom: 14px; font-size: clamp(18px, 6vw, 26px); }
  }
{% endstyle %}

<div class="ai-collection-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if card_collection != blank %}
    <a class="ai-collection-card-{{ ai_gen_id }}__link" href="{{ card_collection.url }}" aria-label="{{ card_title | escape }}">
      {% if card_image != blank %}
        <img class="ai-collection-card-{{ ai_gen_id }}__media" src="{{ card_image | image_url: width: 1200 }}" alt="{{ card_image.alt | default: card_title | escape }}" loading="lazy" width="{{ card_image.width }}" height="{{ card_image.height }}">
      {% else %}
        <div class="ai-collection-card-{{ ai_gen_id }}__placeholder">
          {{ 'collection-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
      <span class="ai-collection-card-{{ ai_gen_id }}__shade" aria-hidden="true"></span>
      {% if card_title != blank %}<h3 class="ai-collection-card-{{ ai_gen_id }}__title">{{ card_title | escape }}</h3>{% endif %}
    </a>
  {% else %}
    <div class="ai-collection-card-{{ ai_gen_id }}__link" {{ block.shopify_attributes }}>
      <div class="ai-collection-card-{{ ai_gen_id }}__placeholder">
        {{ 'collection-apparel-1' | placeholder_svg_tag }}
        <span class="ai-collection-card-{{ ai_gen_id }}__shade" aria-hidden="true"></span>
        <h3 class="ai-collection-card-{{ ai_gen_id }}__title">Select a collection</h3>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection image card",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "custom_image", "label": "Custom image" },
    { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use the collection title." },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 2", "label": "Landscape" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "4 / 5"
    },
    { "type": "range", "id": "overlay_strength", "label": "Overlay strength", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Collection image card" }],
  "tag": null,
  "class": "collection-image-card"
}
{% endschema %}